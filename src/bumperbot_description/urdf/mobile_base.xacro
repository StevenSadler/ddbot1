<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="is_ignition" default="true" />

    <xacro:property name="unit" value="0.038" />

    <xacro:property name="base_length" value="${unit * 3}" />
    <xacro:property name="base_width" value="${unit * 3}" />
    <xacro:property name="base_height" value="${unit * 3}" />

    <xacro:property name="tail_length" value="${unit * 5}" />
    <xacro:property name="tail_width" value="${unit * 1}" />
    <xacro:property name="tail_height" value="${unit * 0.5}" />

    <xacro:property name="caster_radius" value="${unit * 0.75}" />

    <xacro:property name="hub_width" value="0.013" />
    <xacro:property name="cross_beam_length" value="${unit * 1}" />
    <xacro:property name="cross_beam_width" value="${unit * 6 + hub_width * 2}" />
    <xacro:property name="cross_beam_height" value="${unit * 1}" />

    <xacro:property name="wheel_radius" value="${unit * 1}" />
    <xacro:property name="wheel_length" value="0.024" />

    
    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="0.75" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <link name="tail_link">
        <visual>
            <geometry>
                <box size="${tail_length} ${tail_width} ${tail_height}" />
            </geometry>
            <origin xyz="0 0 ${tail_height / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${tail_length} ${tail_width} ${tail_height}" />
            </geometry>
            <origin xyz="0 0 ${tail_height / 2.0}" rpy="0 0 0" />
        </collision>
    </link>

    <link name="caster_link">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:sphere_inertia m="0.25" r="${caster_radius}" 
                              o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <link name="cross_beam_link">
        <visual>
            <geometry>
                <box size="${cross_beam_length} ${cross_beam_width} ${cross_beam_height}" />
            </geometry>
            <origin xyz="0 0 ${cross_beam_height / 2.0}" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <box size="${cross_beam_length} ${cross_beam_width} ${cross_beam_height}" />
            </geometry>
            <origin xyz="0 0 ${cross_beam_height / 2.0}" rpy="0 0 0" />
        </collision>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="yellow" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>
            <xacro:cylinder_inertia m="0.25" r="${wheel_radius}" l="${wheel_length}"
                                    o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="${-unit} 0 ${wheel_radius + cross_beam_height / 2.0 + tail_height}" rpy="0 0 0"/>
    </joint>

    <joint name="base_tail_joint" type="fixed">
        <parent link="base_link" />
        <child link="tail_link" />
        <origin xyz="${-unit} 0 ${-tail_height}" rpy="0 0 0"/>
    </joint>

    <joint name="tail_caster_joint" type="fixed">
        <parent link="tail_link" />
        <child link="caster_link" />
        <origin xyz="${-unit * 2} 0 ${-caster_radius}" rpy="0 0 0"/>
    </joint>
    
    <joint name="riser_cross_beam_joint" type="fixed">
        <parent link="tail_link" />
        <child link="cross_beam_link" />
        <origin xyz="${unit * 2} 0 ${-cross_beam_height}" rpy="0 0 0"/>
    </joint>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="cross_beam_link" />
        <child link="right_wheel_link" />
        <origin xyz="0 ${-(cross_beam_width + wheel_length) / 2.0} ${cross_beam_height / 2.0}" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
    </joint>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="cross_beam_link" />
        <child link="left_wheel_link" />
        <origin xyz="0 ${(cross_beam_width + wheel_length) / 2.0} ${cross_beam_height / 2.0}" rpy="0 0 0"/>
        <axis xyz="0 1 0" />
    </joint>

</robot>